# Public site origin (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.bigbrosai.com

# Existing BigBrosAI application. All Log In / Get Started buttons point here.
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.bigbrosai.com
# Optional: dedicated login / registration URLs if the dashboard exposes them.
# NEXT_PUBLIC_DASHBOARD_LOGIN_URL=
# NEXT_PUBLIC_DASHBOARD_SIGNUP_URL=

# Google Search Console HTML-tag verification token (content="..." value)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form delivery (server-side only) — sent through the BigBrosAI Email API.
# Without these the form falls back to opening a prefilled email.
# BBAI_EMAIL_API_KEY=
# CONTACT_FROM_EMAIL=noreply@bigbrosai.com   # must be on a domain verified in your BigBrosAI project
# CONTACT_TO_EMAIL=support@bigbrosai.com
# BBAI_API_URL=https://api.bigbrosai.com/api/v1
